<% layout('/layouts/boilerplate') -%>

<div class="row mt-3">
  <div class="col-8 offset-2">
    <h3><%= listing.title %></h3>
  </div>

  <div class="col-8 offset-2">
    <div class="card show-card listing-card">
      <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="listing-image">
      <div class="card-body">
        <p class="card-text"><i>Owned By <%= listing.owner.username %></i></p>
        <p><%= listing.description %></p>
        <p>&#8377; <%= listing.price.toLocaleString("en-IN") %></p>
          <p><span id="location" data-value="<%= listing.location %>"><%= listing.location %></span></p>
        <p><%= listing.country %></p>
      </div>
    </div>
    
    <div class="mt-3">
      <% if (currentUser && listing.owner._id.equals(currentUser._id)) { %>
          <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark add-btn">Edit</a>
          <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="d-inline">
            <button class="btn btn-dark">Delete</button>
          </form>
      <% } else { %>
        <!-- <form method="GET" action="/listings/<%=listing._id%>/book">
          <button class="btn book-btn">Book Now</button>
        </form> -->
          <button class="btn book-btn">Book Now</button>
      <% } %>
    </div>
  
    <hr class="my-4">
    <%- include('review') %>

</div>
