<link rel="stylesheet" href="/css/navbar.css">
<link rel="stylesheet" href="/css/theme.css">
<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">
  <div class="container-fluid">
    <a class="navbar-brand d-flex align-items-center gap-2" href="/listings">
      <i class="fa-regular fa-compass"></i>
      <span class="brand-name">WanderWells</span>
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <div class="navbar-nav ms-3">
        <% if (currentUser) { %>
          <a class="nav-link" href="/listings/new">Rent Your Home</a>
        <% } %>
        <div class="navbar-nav themeToggle">
          <input type="checkbox" id="theme-toggle">
          <label id="theme" for="theme-toggle">
             <i class="fa-regular fa-sun"></i>
             <i class="fa-regular fa-moon"></i>
          </label>
        </div>
      </div>
      
      <div class="navbar-nav ms-auto me-3">
        <form class="d-flex" role="search" action="/listings/search" method="get">
          <input class="form-control me-2 search-input" type="search" placeholder="Search destinations" aria-label="Search" name="city">
          <button class="btn search-btn" type="submit">
            <i class="fa fa-solid fa-magnifying-glass"></i> Search
          </button>
        </form>
      </div>
      
      <div class="navbar-nav">
        <% if (!currentUser) { %>
          <a class="nav-link" href="/signup"><b>Sign Up</b></a>
          <a class="nav-link" href="/login"><b>Login</b></a>
        <% } %>
        <% if (currentUser) { %>
          <span class="nav-link text-muted">Hi, <%= currentUser.username %></span>
          <a class="nav-link" href="/logout"><b>Logout</b></a>
        <% } %>
      </div>
    </div>
  </div>
</nav>
<script src="/js/navFilter.js"></script>
<script src="/js/theme.js"></script>
