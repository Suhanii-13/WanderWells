<div class="row"> 
    <div class="col-8 offset-2">
        <form action="/book/razorpay/success" method="post">
            <h2>Complete Your Payment</h2>
            <p>Total Amount: ₹<%= amount %></p>

            <!-- Booking Data as Hidden Fields -->
            <input type="hidden" name="listingId" value="<%= listingId %>">
            <input type="hidden" name="numberOfPeople" value="<%= bookingData.numberOfPeople %>">
            <input type="hidden" name="startDate" value="<%= bookingData.startDate %>">
            <input type="hidden" name="endDate" value="<%= bookingData.endDate %>">
            <input type="hidden" name="name" value="<%= bookingData.name %>">
            <input type="hidden" name="email" value="<%= bookingData.email %>">

            <!-- Razorpay-specific fields -->
            <input type="hidden" id="razorpay_payment_id" name="razorpay_payment_id">
            <input type="hidden" id="razorpay_order_id" name="razorpay_order_id">
            <input type="hidden" id="razorpay_signature" name="razorpay_signature">
            
            <button type="button" class="btn btn-primary" id="rzp-button1">Proceed to Payment</button>
        </form>
    </div>
</div>

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
    var options = {
        "key": "<%= razorpayKeyId %>",
        "amount": "<%= amount %>00", 
        "currency": "INR",
        "name": "wanderWell",
        "description": "Test Transaction",
        "order_id": "<%= orderId %>",
        "handler": function(response) {
            document.getElementById('razorpay_payment_id').value = response.razorpay_payment_id;
            document.getElementById('razorpay_order_id').value = response.razorpay_order_id;
            document.getElementById('razorpay_signature').value = response.razorpay_signature;
            document.forms[0].submit();
        },
        "prefill": {
            "name": "<%= bookingData.name %>",
            "email": "<%= bookingData.email %>",
            "contact": "<%= bookingData.contact %>"
        },
        "theme": {
            "color": "#3399cc"
        }
    };

    var rzp1 = new Razorpay(options);
    document.getElementById('rzp-button1').onclick = function(e) {
        rzp1.open();
        e.preventDefault();
    };
</script>
