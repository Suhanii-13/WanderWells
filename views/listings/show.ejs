<% layout('/layouts/boilerplate') -%>

  <div class="row mt-3">
    <div class="col-8 offset-2">
      <h3>
        <%= listing.title %>
      </h3>
    </div>

    <div class="col-8 offset-2">
      <div class="card show-card listing-card">
        <img src="<%= listing.image && listing.image.url ? listing.image.url : '/images/all.png' %>"
          class="card-img-top show-img" alt="<%= listing.title %>" onerror="this.src='/images/all.png'">
        <div class="card-body">
          <p class="card-text"><i>Owned by <strong>
                <%= listing.owner ? listing.owner.username : 'WanderWells' %>
              </strong></i></p>
          <p>
            <%= listing.description %>
          </p>
          <p class="fs-5"><strong>&#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : '0' %></strong>
            <span class="text-muted">/night</span>
            <i class="tax-info ms-2" style="color:green; font-size:0.85rem;">+18% GST</i>
          </p>
          <p><i class="fa-solid fa-location-dot text-danger"></i>
            <%= listing.location %>
              <% if(listing.country) { %>, <%= listing.country %>
                  <% } %>
          </p>
          <% if (listing.category) { %>
            <span class="badge bg-secondary">
              <%= listing.category %>
            </span>
            <% } %>
        </div>
      </div>

      <div class="mt-3 d-flex gap-2">
        <% if (currentUser && listing.owner && listing.owner._id.equals(currentUser._id)) { %>
          <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark add-btn">Edit</a>
          <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="d-inline">
            <button class="btn btn-danger">Delete</button>
          </form>
          <% } else { %>
            <button class="btn book-btn" data-bs-toggle="modal" data-bs-target="#bookingModal">Book Now</button>
            <% } %>
      </div>

      <hr class="my-4">

      <!-- Map -->
      <div class="mb-4">
        <h5><i class="fa-solid fa-map-location-dot me-2"></i>Where you'll be</h5>
        <div id="map" style="height: 300px; border-radius: 1rem; z-index:0;"></div>
        <script>
          document.addEventListener('DOMContentLoaded', function () {
            const locationStr = "<%= listing.location ? listing.location.replace(/"/g, '') : '' %>, <%= listing.country ? listing.country.replace(/"/g, '') : '' %>";
          const coords = <%- JSON.stringify((listing.geometry && listing.geometry.coordinates && listing.geometry.coordinates[0] !== 0) ? listing.geometry.coordinates : null) %>;

          const initMap = (lat, lng) => {
            const map = L.map('map').setView([lat, lng], 10);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
              attribution: '© OpenStreetMap contributors'
            }).addTo(map);
            L.marker([lat, lng]).addTo(map)
              .bindPopup("<b><%= listing.title.replace(/"/g, '') %></b><br><%= listing.location ? listing.location.replace(/"/g, '') : '' %>")
                .openPopup();
          };

                if (coords && coords[0] !== 0) {
                  initMap(coords[1], coords[0]);
          } else if (locationStr.trim() !== ',') {
                  fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(locationStr)}&limit=1`)
                    .then(r => r.json())
                    .then(data => {
                      if (data && data.length > 0) {
                        initMap(parseFloat(data[0].lat), parseFloat(data[0].lon));
                      } else {
                        initMap(20.5937, 78.9629);
                      }
                    })
                    .catch(() => initMap(20.5937, 78.9629));
          } else {
                  initMap(20.5937, 78.9629);
          }
        });
        </script>
      </div>

      <%- include('review') %>

    </div>
  </div>

<!-- Booking Modal -->
<div class="modal fade" id="bookingModal" tabindex="-1" aria-labelledby="bookingModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="border-radius: 1.2rem; border: none; box-shadow: 0 10px 30px rgba(0,0,0,0.15);">
      
      <!-- Booking Form State -->
      <div id="bookingFormState">
        <div class="modal-header border-0 pb-0">
          <h5 class="modal-title fw-bold" id="bookingModalLabel" style="color: #3f7dc4;">Book Your Stay</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <p class="text-muted small mb-3">Confirm your details to book your stay at <strong><%= listing.title %></strong>.</p>
          
          <form id="bookingForm" class="needs-validation" novalidate>
            <div class="row g-3">
              <div class="col-md-6">
                <label for="checkInDate" class="form-label text-secondary small fw-semibold">Check-in</label>
                <input type="date" class="form-control" id="checkInDate" required style="border-radius: 0.6rem;">
              </div>
              <div class="col-md-6">
                <label for="checkOutDate" class="form-label text-secondary small fw-semibold">Check-out</label>
                <input type="date" class="form-control" id="checkOutDate" required style="border-radius: 0.6rem;">
              </div>
              
              <div class="col-12">
                <label for="guestCount" class="form-label text-secondary small fw-semibold">Guests</label>
                <select class="form-select" id="guestCount" style="border-radius: 0.6rem;">
                  <option value="1" selected>1 Guest</option>
                  <option value="2">2 Guests</option>
                  <option value="3">3 Guests</option>
                  <option value="4">4+ Guests</option>
                </select>
              </div>
            </div>

            <!-- Price Breakdown Card -->
            <div class="card bg-light border-0 mt-3 p-3" style="border-radius: 0.8rem;">
              <div class="d-flex justify-content-between mb-2">
                <span class="text-secondary small">₹<%= (listing.price || 0).toLocaleString("en-IN") %> x <span id="nightsCountDisplay">1</span> night(s)</span>
                <span class="fw-semibold text-dark small">₹<span id="subtotalDisplay">0</span></span>
              </div>
              <div class="d-flex justify-content-between mb-2">
                <span class="text-secondary small">GST (18%)</span>
                <span class="fw-semibold text-dark small">₹<span id="gstDisplay">0</span></span>
              </div>
              <hr class="my-2 text-secondary">
              <div class="d-flex justify-content-between">
                <span class="fw-bold text-dark">Total</span>
                <span class="fw-bold" style="color: #3f7dc4; font-size: 1.15rem;">₹<span id="totalDisplay">0</span></span>
              </div>
            </div>

            <!-- Payment Method Choice -->
            <div class="mt-3">
              <label class="form-label text-secondary small fw-semibold d-block">Select Payment Method</label>
              <div class="d-flex gap-2">
                <div class="form-check flex-fill border p-2 rounded text-center" style="cursor: pointer;">
                  <input class="form-check-input d-none" type="radio" name="paymentMethod" id="payRazorpay" value="razorpay" checked>
                  <label class="form-check-label w-100 style-pointer" for="payRazorpay">
                    <i class="fa-solid fa-credit-card me-1 text-primary"></i> Razorpay
                  </label>
                </div>
                <div class="form-check flex-fill border p-2 rounded text-center" style="cursor: pointer;">
                  <input class="form-check-input d-none" type="radio" name="paymentMethod" id="payPaypal" value="paypal">
                  <label class="form-check-label w-100 style-pointer" for="payPaypal">
                    <i class="fa-brands fa-paypal me-1 text-info"></i> PayPal
                  </label>
                </div>
              </div>
            </div>

            <button type="submit" class="btn w-100 mt-4 py-2 fw-semibold text-white" style="background-color: #3f7dc4; border-radius: 0.8rem; border: none; transition: 0.2s;">
              Confirm Booking
            </button>
          </form>
        </div>
      </div>

      <!-- Booking Success State (Initially Hidden) -->
      <div id="bookingSuccessState" class="d-none text-center py-5 px-4">
        <div class="success-checkmark mb-4">
          <div class="check-icon" style="font-size: 4rem; color: #198754; animation: popIn 0.5s ease-out;">
            <i class="fa-regular fa-circle-check"></i>
          </div>
        </div>
        <h4 class="fw-bold text-success mb-2">Booking Confirmed!</h4>
        <p class="text-secondary px-3 mb-4">Your booking at <strong><%= listing.title %></strong> is confirmed!</p>
        
        <div class="card border-0 bg-light p-3 mb-4 text-start small mx-auto" style="max-width: 320px; border-radius: 0.8rem;">
          <div class="mb-2"><strong>Check-in:</strong> <span id="successCheckIn"></span></div>
          <div class="mb-2"><strong>Check-out:</strong> <span id="successCheckOut"></span></div>
          <div class="mb-2"><strong>Guests:</strong> <span id="successGuests"></span></div>
          <div class="mb-2"><strong>Amount Paid:</strong> ₹<span id="successAmount"></span></div>
          <div><strong>Booking Ref:</strong> <span id="successRef" class="text-monospace"></span></div>
        </div>

        <button type="button" class="btn text-white px-4" data-bs-dismiss="modal" style="background-color: #3f7dc4; border-radius: 0.6rem; border: none;">
          Great, Thank You!
        </button>
      </div>

    </div>
  </div>
</div>

<style>
  .style-pointer {
    cursor: pointer;
  }
  .form-check input:checked + label {
    font-weight: bold;
    color: #3f7dc4;
  }
  .form-check:has(input:checked) {
    border-color: #3f7dc4 !important;
    background-color: #f0f7ff;
  }
  @keyframes popIn {
    0% { transform: scale(0); opacity: 0; }
    80% { transform: scale(1.2); }
    100% { transform: scale(1); opacity: 1; }
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const pricePerNight = <%= listing.price || 0 %>;
  const checkInInput = document.getElementById('checkInDate');
  const checkOutInput = document.getElementById('checkOutDate');
  const guestCountInput = document.getElementById('guestCount');
  
  const nightsCountDisplay = document.getElementById('nightsCountDisplay');
  const subtotalDisplay = document.getElementById('subtotalDisplay');
  const gstDisplay = document.getElementById('gstDisplay');
  const totalDisplay = document.getElementById('totalDisplay');

  // Set default dates
  const today = new Date();
  const tomorrow = new Date();
  tomorrow.setDate(today.getDate() + 1);
  const dayAfter = new Date();
  dayAfter.setDate(tomorrow.getDate() + 2); // 2 nights default

  if (checkInInput && checkOutInput) {
    checkInInput.value = tomorrow.toISOString().split('T')[0];
    checkOutInput.value = dayAfter.toISOString().split('T')[0];
    checkInInput.min = today.toISOString().split('T')[0];

    function updatePrice() {
      const checkInDate = new Date(checkInInput.value);
      const checkOutDate = new Date(checkOutInput.value);
      
      // Ensure check out is after check in
      checkOutInput.min = checkInInput.value;
      
      if (checkOutDate <= checkInDate) {
        const nextDay = new Date(checkInDate);
        nextDay.setDate(checkInDate.getDate() + 1);
        checkOutInput.value = nextDay.toISOString().split('T')[0];
      }
      
      const timeDiff = new Date(checkOutInput.value).getTime() - new Date(checkInInput.value).getTime();
      const nights = Math.max(1, Math.ceil(timeDiff / (1000 * 3600 * 24)));
      
      const subtotal = pricePerNight * nights;
      const gst = Math.round(subtotal * 0.18);
      const total = subtotal + gst;
      
      if (nightsCountDisplay) nightsCountDisplay.innerText = nights;
      if (subtotalDisplay) subtotalDisplay.innerText = subtotal.toLocaleString("en-IN");
      if (gstDisplay) gstDisplay.innerText = gst.toLocaleString("en-IN");
      if (totalDisplay) totalDisplay.innerText = total.toLocaleString("en-IN");
    }

    checkInInput.addEventListener('change', updatePrice);
    checkOutInput.addEventListener('change', updatePrice);
    updatePrice();

    // Form submission handler
    const bookingForm = document.getElementById('bookingForm');
    if (bookingForm) {
      bookingForm.addEventListener('submit', function (e) {
        e.preventDefault();
        if (!bookingForm.checkValidity()) {
          e.stopPropagation();
          bookingForm.classList.add('was-validated');
          return;
        }

        // Populate success info
        const successCheckIn = document.getElementById('successCheckIn');
        const successCheckOut = document.getElementById('successCheckOut');
        const successGuests = document.getElementById('successGuests');
        const successAmount = document.getElementById('successAmount');
        const successRef = document.getElementById('successRef');

        if (successCheckIn) successCheckIn.innerText = new Date(checkInInput.value).toLocaleDateString('en-IN', {day: 'numeric', month: 'short', year: 'numeric'});
        if (successCheckOut) successCheckOut.innerText = new Date(checkOutInput.value).toLocaleDateString('en-IN', {day: 'numeric', month: 'short', year: 'numeric'});
        if (successGuests) successGuests.innerText = guestCountInput.options[guestCountInput.selectedIndex].text;
        if (successAmount && totalDisplay) successAmount.innerText = totalDisplay.innerText;
        if (successRef) successRef.innerText = 'WW-' + Math.random().toString(36).substring(2, 9).toUpperCase();

        // Toggle states
        document.getElementById('bookingFormState').classList.add('d-none');
        document.getElementById('bookingSuccessState').classList.remove('d-none');
      });
    }

    // Reset modal when closed
    const bookingModalEl = document.getElementById('bookingModal');
    if (bookingModalEl) {
      bookingModalEl.addEventListener('hidden.bs.modal', function () {
        document.getElementById('bookingFormState').classList.remove('d-none');
        document.getElementById('bookingSuccessState').classList.add('d-none');
        if (bookingForm) bookingForm.classList.remove('was-validated');
        updatePrice();
      });
    }
  }
});
</script>