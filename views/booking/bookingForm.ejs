<% layout('/layouts/boilerplate') -%>
<br><br><br><br><br><br>
<div class="row"> 
    <div class="col-8 offset-2">
        <form action="/booking/submit" method="POST">

            <div class="mb-3">
                <label for="leader" class="form-label">Name:</label>
                <input type="text" id="leader" name="leader" class="form-control" required placeholder="Enter leader's name">
            </div>

            <div class="mb-3">
                <label for="startDate" class="form-label">Start Date:</label>
                <input type="date" id="startDate" name="startDate" class="form-control" required>
            </div>

            <div class="mb-3">
                <label for="endDate" class="form-label">End Date:</label>
                <input type="date" id="endDate" name="endDate" class="form-control" required>
            </div>

            <div class="mb-3">
                <label for="people" class="form-label">Number of People:</label>
                <input type="number" id="people" name="people" class="form-control" required>
            </div>

            <div class="mb-3">
                <label for="payment" class="form-label">Choose Payment Method:</label>

                <div class="form-check">
                    <input class="form-check-input" type="radio" name="paymentMethod" id="flexRadioDefault1" value="razorpay">
                    <label class="form-check-label" for="flexRadioDefault1">
                        Razorpay
                    </label>
                </div>

                <div class="form-check">
                    <input class="form-check-input" type="radio" name="paymentMethod" id="flexRadioDefault2" value="paypal" checked>
                    <label class="form-check-label" for="flexRadioDefault2">
                        PayPal
                    </label>
                </div>
            </div>

            <button type="submit" class="btn btn-primary">Proceed to Payment</button>
        </form>
    </div>
</div>
