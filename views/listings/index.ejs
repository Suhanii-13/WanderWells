<% layout('/layouts/boilerplate') -%>
<%- include('../includes/filters') %>

<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 marginTop">
    <% if (alllisting && alllisting.length > 0) { %>
        <% for (let listing of alllisting) { %>
            <a href="/listings/<%= listing._id %>" class="listing-link">
                <div class="card col listing-card">
                    <img 
                        src="<%= listing.image && listing.image.url ? listing.image.url : '/images/all.png' %>"
                        class="card-img-top"
                        alt="<%= listing.title %>"
                        style="height: 20rem; object-fit: cover;"
                        onerror="this.src='/images/all.png'">
                    <div class="card-img-overlay"></div>
                    <div class="card-body">
                        <p class="card-text">
                            <p><b><%= listing.title %></b></p>
                            <p class="text-muted" style="font-size:0.9rem;"><%= listing.location %></p>
                            &#8377;<%= listing.price ? listing.price.toLocaleString("en-IN") : '0' %>/night
                            <i class="tax-info" style="color: green; display:none;"> &nbsp;+18% GST</i>
                        </p>
                    </div>
                </div>
            </a>
        <% } %>
    <% } else { %>
        <div class="col-12 text-center mt-5">
            <div class="no-listings">
                <i class="fa-solid fa-compass fa-3x text-muted mb-3"></i>
                <p class="fs-5 text-muted">No listings found. Try a different search!</p>
                <a href="/listings" class="btn btn-dark mt-2">View All Listings</a>
            </div>
        </div>
    <% } %>
</div>
